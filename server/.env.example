ATLAS_APP_NAME=Atlas API
ATLAS_ENVIRONMENT=development
ATLAS_DEBUG=true
ATLAS_DATABASE_URL=postgresql+psycopg_async://atlas:atlas@localhost:5432/atlas
ATLAS_EXPERIMENTS_ENABLED=false
# Pool sizing — total per-process ceiling = pool_size + max_overflow.
# Mind PostgreSQL's max_connections (=100): leave headroom for psql, tests, other clients.
ATLAS_POOL_SIZE=5
ATLAS_MAX_OVERFLOW=10